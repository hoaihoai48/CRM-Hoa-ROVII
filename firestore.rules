rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: kiểm tra user đã đăng nhập vào hệ thống
    function isAuthenticated() {
      return request.auth != null;
    }

    // Orders: Nghiệp vụ đơn hàng nội bộ tiệm, chỉ cho phép nhân viên đã đăng nhập
    match /orders/{orderId} {
      allow read, write: if isAuthenticated();
    }

    // Customers: Thông tin khách hàng và số điện thoại, chỉ cho phép nhân viên đã đăng nhập
    match /customers/{customerId} {
      allow read, write: if isAuthenticated();
    }

    // Products: Bảng giá & sản phẩm nội bộ tiệm, chỉ cho phép nhân viên đã đăng nhập
    match /products/{productId} {
      allow read, write: if isAuthenticated();
    }

    // Settings: Cấu hình tiệm hoa, chỉ cho phép nhân viên đã đăng nhập
    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }
  }
}
