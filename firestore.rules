rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function membershipPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isActiveMember() {
      return isAuthenticated()
        && exists(membershipPath())
        && get(membershipPath()).data.status == 'active'
        && get(membershipPath()).data.role in ['admin', 'staff'];
    }

    function isAdmin() {
      return isActiveMember()
        && get(membershipPath()).data.role == 'admin';
    }

    // Membership records are provisioned only by a trusted administrative path.
    match /users/{userId} {
      allow get: if isAuthenticated() && request.auth.uid == userId;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Active staff and admins may manage day-to-day CRM records.
    match /orders/{orderId} {
      allow read, write: if isActiveMember();
    }

    match /customers/{customerId} {
      allow read, write: if isActiveMember();
    }

    match /products/{productId} {
      allow read, write: if isActiveMember();
    }

    // Store configuration is readable by active members, but editable only by admins.
    match /settings/{settingId} {
      allow read: if isActiveMember();
      allow create, update, delete: if isAdmin();
    }
  }
}
