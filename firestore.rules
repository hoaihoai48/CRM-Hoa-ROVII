rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function membershipPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isActiveMember() {
      return isAuthenticated()
        && exists(membershipPath())
        && get(membershipPath()).data.status == 'active'
        && get(membershipPath()).data.role in ['admin', 'staff'];
    }

    function isAdmin() {
      return isActiveMember() && get(membershipPath()).data.role == 'admin';
    }

    function validOrder(data) {
      return data.keys().hasOnly([
          'customerId', 'customerSnapshot', 'items', 'summary', 'status',
          'statusHistory', 'note', 'createdAt', 'createdBy', 'deliveryDate'
        ])
        && data.keys().hasAll([
          'customerId', 'customerSnapshot', 'items', 'summary', 'status',
          'statusHistory', 'createdAt', 'createdBy'
        ])
        && data.customerId is string
        && data.customerId.size() > 0
        && data.customerSnapshot is map
        && data.customerSnapshot.keys().hasOnly(['name', 'phone', 'address'])
        && data.customerSnapshot.name is string
        && data.customerSnapshot.phone is string
        && data.customerSnapshot.address is string
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 100
        && data.summary is map
        && data.summary.keys().hasOnly(['subtotal', 'deliveryFee', 'discount', 'total'])
        && data.summary.subtotal is number
        && data.summary.subtotal >= 0
        && data.summary.deliveryFee is number
        && data.summary.deliveryFee >= 0
        && data.summary.discount is number
        && data.summary.discount >= 0
        && data.summary.total is number
        && data.summary.total >= 0
        && data.status in ['new', 'confirmed', 'delivering', 'completed', 'cancelled']
        && data.statusHistory is list
        && data.statusHistory.size() > 0
        && data.createdAt is string
        && data.createdBy is string
        && (!('note' in data.keys()) || data.note == null || data.note is string)
        && (!('deliveryDate' in data.keys()) || data.deliveryDate == null || data.deliveryDate is string);
    }

    function validCustomer(data) {
      return data.keys().hasOnly([
          'name', 'phone', 'phoneNormalized', 'address',
          'totalOrders', 'totalSpent', 'lastOrderDate', 'orderSummaries',
          'note', 'createdAt'
        ])
        && data.keys().hasAll([
          'name', 'phone', 'phoneNormalized', 'address',
          'totalOrders', 'totalSpent', 'lastOrderDate', 'createdAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.phone is string
        && data.phoneNormalized is string
        && data.address is string
        && data.totalOrders is int
        && data.totalOrders >= 0
        && data.totalSpent is number
        && data.totalSpent >= 0
        && data.lastOrderDate is string
        && data.createdAt is string
        && (!('orderSummaries' in data.keys()) || data.orderSummaries is list)
        && (!('note' in data.keys()) || data.note == null || data.note is string);
    }

    // Membership records remain admin-managed. Users can read their own membership.
    match /users/{userId} {
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.role in ['admin', 'staff']
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'role', 'status', 'createdAt', 'updatedAt']);
      allow delete: if false;
    }

    function validInitialOrder(data) {
      return validOrder(data)
        && data.status == 'new'
        && data.statusHistory.size() == 1
        && validStatusHistoryEntry(data.statusHistory[0])
        && data.statusHistory[0].status == 'new';
    }

    function validStatusHistoryEntry(entry) {
      return entry is map
        && entry.keys().hasOnly(['id', 'status', 'timestamp', 'note', 'actorName'])
        && entry.keys().hasAll(['id', 'status', 'timestamp', 'actorName'])
        && entry.id is string
        && entry.id.size() > 0
        && entry.status in ['new', 'confirmed', 'delivering', 'completed', 'cancelled']
        && entry.timestamp is string
        && entry.timestamp.size() > 0
        && entry.actorName is string
        && entry.actorName.size() > 0
        && (!('note' in entry.keys()) || entry.note == null || entry.note is string);
    }

    function validStatusTransition(from, to) {
      return (from == 'new' && to in ['confirmed', 'cancelled'])
        || (from == 'confirmed' && to in ['delivering', 'cancelled'])
        || (from == 'delivering' && to == 'completed');
    }

    // History must append exactly one valid entry while preserving the complete prior
    // list in its original order. Same-status edits are permitted only before delivery.
    // Lifecycle transitions may change only status + history, never order/financial data.
    function validStatusChange(oldData, newData) {
      let historySize = newData.statusHistory.size();
      let sameStatus = newData.status == oldData.status;
      let historyEntry = newData.statusHistory[historySize - 1];
      return historySize == oldData.statusHistory.size() + 1
        && newData.statusHistory == oldData.statusHistory.concat([historyEntry])
        && validStatusHistoryEntry(historyEntry)
        && historyEntry.status == newData.status
        && (
          (sameStatus && oldData.status in ['new', 'confirmed'])
          || (
            !sameStatus
            && validStatusTransition(oldData.status, newData.status)
            && newData.diff(oldData).affectedKeys().hasOnly(['status', 'statusHistory'])
          )
        );
    }

    // Order writes must keep the corresponding per-order customer projection coherent
    // in the same transaction/batch. This does not prove the customer's full aggregates.
    function hasMatchingCustomerOrderProjection(orderId, orderData) {
      let customerAfter = getAfter(
        /databases/$(database)/documents/customers/$(orderData.customerId)
      );
      let expectedSummary = {
        'id': orderId,
        'status': orderData.status,
        'total': orderData.summary.total,
        'createdAt': orderData.createdAt
      };
      return customerAfter.data.orderSummaries is list
        && expectedSummary in customerAfter.data.orderSummaries;
    }

    // Spark-compatible internal-team model. Rules enforce lifecycle and document invariants,
    // but cannot prove cross-document arithmetic or reconstruct customer aggregates.
    match /orders/{orderId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember()
        && validInitialOrder(request.resource.data)
        && hasMatchingCustomerOrderProjection(orderId, request.resource.data);
      allow update: if isActiveMember()
        && validOrder(request.resource.data)
        && validStatusChange(resource.data, request.resource.data)
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && hasMatchingCustomerOrderProjection(orderId, request.resource.data);
      allow delete: if false;
    }

    match /customers/{customerId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember()
        && validCustomer(request.resource.data)
        && request.resource.data.totalOrders == 0
        && request.resource.data.totalSpent == 0
        && request.resource.data.lastOrderDate == ''
        && (!('orderSummaries' in request.resource.data.keys())
          || request.resource.data.orderSummaries.size() == 0);
      allow update: if isActiveMember() && validCustomer(request.resource.data)
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.phoneNormalized == resource.data.phoneNormalized
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    function validProduct(data) {
      return data.keys().hasOnly([
          'name', 'price', 'unit', 'isActive', 'category',
          'imageUrl', 'imageUrls', 'note', 'createdAt'
        ])
        && data.keys().hasAll(['name', 'price', 'unit', 'isActive', 'createdAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && data.price is number
        && data.price >= 0
        && data.unit is string
        && data.unit.size() > 0
        && data.unit.size() <= 40
        && data.isActive is bool
        && data.createdAt is string
        && (data.get('category', null) == null || data.category is string)
        && (data.get('imageUrl', null) == null || data.imageUrl is string)
        && data.get('imageUrls', []) is list
        && data.get('imageUrls', []).size() <= 5
        && (data.get('note', null) == null || data.note is string);
    }

    // Product catalog policy: all active members can read; only admins can create
    // or edit. createdAt is immutable and delete is disabled to preserve order history.
    match /products/{productId} {
      allow read: if isActiveMember();
      allow create: if isAdmin() && validProduct(request.resource.data);
      allow update: if isAdmin()
        && validProduct(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'price', 'unit', 'isActive', 'category',
          'imageUrl', 'imageUrls', 'note'
        ]);
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow read: if isActiveMember();
      allow create, update, delete: if isAdmin();
    }
  }
}
