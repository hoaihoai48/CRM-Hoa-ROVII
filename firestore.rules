rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function membershipPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isActiveMember() {
      return isAuthenticated()
        && exists(membershipPath())
        && get(membershipPath()).data.status == 'active'
        && get(membershipPath()).data.role in ['admin', 'staff'];
    }

    function isAdmin() {
      return isActiveMember() && get(membershipPath()).data.role == 'admin';
    }

    function validOrder(data) {
      return data.keys().hasOnly([
          'customerId', 'customerSnapshot', 'items', 'summary', 'status',
          'statusHistory', 'note', 'createdAt', 'createdBy', 'createdByUid', 'deliveryDate'
        ])
        && data.keys().hasAll([
          'customerId', 'customerSnapshot', 'items', 'summary', 'status',
          'statusHistory', 'createdAt', 'createdBy'
        ])
        && data.customerId is string
        && data.customerId.size() > 0
        && data.customerSnapshot is map
        && data.customerSnapshot.keys().hasOnly(['name', 'phone', 'address'])
        && data.customerSnapshot.name is string
        && data.customerSnapshot.phone is string
        && data.customerSnapshot.address is string
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 100
        && data.summary is map
        && data.summary.keys().hasOnly(['subtotal', 'deliveryFee', 'discount', 'total'])
        && data.summary.subtotal is number
        && data.summary.subtotal >= 0
        && data.summary.deliveryFee is number
        && data.summary.deliveryFee >= 0
        && data.summary.discount is number
        && data.summary.discount >= 0
        && data.summary.total is number
        && data.summary.total >= 0
        && data.status in ['new', 'confirmed', 'delivering', 'completed', 'cancelled']
        && data.statusHistory is list
        && data.statusHistory.size() > 0
        && data.createdAt is string
        && data.createdBy is string
        && (!('createdByUid' in data.keys()) || (data.createdByUid is string && data.createdByUid.size() > 0))
        && (!('note' in data.keys()) || data.note == null || data.note is string)
        && (!('deliveryDate' in data.keys()) || data.deliveryDate == null || data.deliveryDate is string);
    }

    function boundedCustomerProjection(data) {
      return !('orderSummaries' in data.keys()) || data.orderSummaries.size() <= 51;
    }

    function validCustomerOrderSummary(summary) {
      return summary is map
        && summary.keys().hasOnly(['id', 'status', 'total', 'createdAt'])
        && summary.keys().hasAll(['id', 'status', 'total', 'createdAt'])
        && summary.id is string
        && summary.id.size() > 0
        && summary.status in ['new', 'confirmed', 'delivering', 'completed']
        && summary.total is number
        && summary.total >= 0
        && summary.createdAt is string
        && summary.createdAt.size() > 0;
    }

    function summaryAtLeastAsRecent(left, right) {
      return left.createdAt > right.createdAt
        || (left.createdAt == right.createdAt && left.id >= right.id);
    }

    function summaryNoLater(left, right) {
      return left.createdAt < right.createdAt
        || (left.createdAt == right.createdAt && left.id <= right.id);
    }

    // The projection is an active-only bounded cache. Its first row is the latest
    // active order and its last row is the oldest; middle rows need not be trusted
    // for ordering because the service normalizes them before every write.
    function validProjectionBounds(summaries) {
      return summaries is list
        && summaries.size() <= 51
        && (
          summaries.size() == 0
          || (
        && (summaries.size() <= 0 || validCustomerOrderSummary(summaries[0]))
        && (summaries.size() <= 1 || validCustomerOrderSummary(summaries[1]))
        && (summaries.size() <= 2 || validCustomerOrderSummary(summaries[2]))
        && (summaries.size() <= 3 || validCustomerOrderSummary(summaries[3]))
        && (summaries.size() <= 4 || validCustomerOrderSummary(summaries[4]))
        && (summaries.size() <= 5 || validCustomerOrderSummary(summaries[5]))
        && (summaries.size() <= 6 || validCustomerOrderSummary(summaries[6]))
        && (summaries.size() <= 7 || validCustomerOrderSummary(summaries[7]))
        && (summaries.size() <= 8 || validCustomerOrderSummary(summaries[8]))
        && (summaries.size() <= 9 || validCustomerOrderSummary(summaries[9]))
        && (summaries.size() <= 10 || validCustomerOrderSummary(summaries[10]))
        && (summaries.size() <= 11 || validCustomerOrderSummary(summaries[11]))
        && (summaries.size() <= 12 || validCustomerOrderSummary(summaries[12]))
        && (summaries.size() <= 13 || validCustomerOrderSummary(summaries[13]))
        && (summaries.size() <= 14 || validCustomerOrderSummary(summaries[14]))
        && (summaries.size() <= 15 || validCustomerOrderSummary(summaries[15]))
        && (summaries.size() <= 16 || validCustomerOrderSummary(summaries[16]))
        && (summaries.size() <= 17 || validCustomerOrderSummary(summaries[17]))
        && (summaries.size() <= 18 || validCustomerOrderSummary(summaries[18]))
        && (summaries.size() <= 19 || validCustomerOrderSummary(summaries[19]))
        && (summaries.size() <= 20 || validCustomerOrderSummary(summaries[20]))
        && (summaries.size() <= 21 || validCustomerOrderSummary(summaries[21]))
        && (summaries.size() <= 22 || validCustomerOrderSummary(summaries[22]))
        && (summaries.size() <= 23 || validCustomerOrderSummary(summaries[23]))
        && (summaries.size() <= 24 || validCustomerOrderSummary(summaries[24]))
        && (summaries.size() <= 25 || validCustomerOrderSummary(summaries[25]))
        && (summaries.size() <= 26 || validCustomerOrderSummary(summaries[26]))
        && (summaries.size() <= 27 || validCustomerOrderSummary(summaries[27]))
        && (summaries.size() <= 28 || validCustomerOrderSummary(summaries[28]))
        && (summaries.size() <= 29 || validCustomerOrderSummary(summaries[29]))
        && (summaries.size() <= 30 || validCustomerOrderSummary(summaries[30]))
        && (summaries.size() <= 31 || validCustomerOrderSummary(summaries[31]))
        && (summaries.size() <= 32 || validCustomerOrderSummary(summaries[32]))
        && (summaries.size() <= 33 || validCustomerOrderSummary(summaries[33]))
        && (summaries.size() <= 34 || validCustomerOrderSummary(summaries[34]))
        && (summaries.size() <= 35 || validCustomerOrderSummary(summaries[35]))
        && (summaries.size() <= 36 || validCustomerOrderSummary(summaries[36]))
        && (summaries.size() <= 37 || validCustomerOrderSummary(summaries[37]))
        && (summaries.size() <= 38 || validCustomerOrderSummary(summaries[38]))
        && (summaries.size() <= 39 || validCustomerOrderSummary(summaries[39]))
        && (summaries.size() <= 40 || validCustomerOrderSummary(summaries[40]))
        && (summaries.size() <= 41 || validCustomerOrderSummary(summaries[41]))
        && (summaries.size() <= 42 || validCustomerOrderSummary(summaries[42]))
        && (summaries.size() <= 43 || validCustomerOrderSummary(summaries[43]))
        && (summaries.size() <= 44 || validCustomerOrderSummary(summaries[44]))
        && (summaries.size() <= 45 || validCustomerOrderSummary(summaries[45]))
        && (summaries.size() <= 46 || validCustomerOrderSummary(summaries[46]))
        && (summaries.size() <= 47 || validCustomerOrderSummary(summaries[47]))
        && (summaries.size() <= 48 || validCustomerOrderSummary(summaries[48]))
        && (summaries.size() <= 49 || validCustomerOrderSummary(summaries[49]))
        && (summaries.size() <= 50 || validCustomerOrderSummary(summaries[50]))
        && (summaries.size() <= 1 || summaryAtLeastAsRecent(summaries[0], summaries[1]))
        && (summaries.size() <= 2 || summaryAtLeastAsRecent(summaries[0], summaries[2]))
        && (summaries.size() <= 3 || summaryAtLeastAsRecent(summaries[0], summaries[3]))
        && (summaries.size() <= 4 || summaryAtLeastAsRecent(summaries[0], summaries[4]))
        && (summaries.size() <= 5 || summaryAtLeastAsRecent(summaries[0], summaries[5]))
        && (summaries.size() <= 6 || summaryAtLeastAsRecent(summaries[0], summaries[6]))
        && (summaries.size() <= 7 || summaryAtLeastAsRecent(summaries[0], summaries[7]))
        && (summaries.size() <= 8 || summaryAtLeastAsRecent(summaries[0], summaries[8]))
        && (summaries.size() <= 9 || summaryAtLeastAsRecent(summaries[0], summaries[9]))
        && (summaries.size() <= 10 || summaryAtLeastAsRecent(summaries[0], summaries[10]))
        && (summaries.size() <= 11 || summaryAtLeastAsRecent(summaries[0], summaries[11]))
        && (summaries.size() <= 12 || summaryAtLeastAsRecent(summaries[0], summaries[12]))
        && (summaries.size() <= 13 || summaryAtLeastAsRecent(summaries[0], summaries[13]))
        && (summaries.size() <= 14 || summaryAtLeastAsRecent(summaries[0], summaries[14]))
        && (summaries.size() <= 15 || summaryAtLeastAsRecent(summaries[0], summaries[15]))
        && (summaries.size() <= 16 || summaryAtLeastAsRecent(summaries[0], summaries[16]))
        && (summaries.size() <= 17 || summaryAtLeastAsRecent(summaries[0], summaries[17]))
        && (summaries.size() <= 18 || summaryAtLeastAsRecent(summaries[0], summaries[18]))
        && (summaries.size() <= 19 || summaryAtLeastAsRecent(summaries[0], summaries[19]))
        && (summaries.size() <= 20 || summaryAtLeastAsRecent(summaries[0], summaries[20]))
        && (summaries.size() <= 21 || summaryAtLeastAsRecent(summaries[0], summaries[21]))
        && (summaries.size() <= 22 || summaryAtLeastAsRecent(summaries[0], summaries[22]))
        && (summaries.size() <= 23 || summaryAtLeastAsRecent(summaries[0], summaries[23]))
        && (summaries.size() <= 24 || summaryAtLeastAsRecent(summaries[0], summaries[24]))
        && (summaries.size() <= 25 || summaryAtLeastAsRecent(summaries[0], summaries[25]))
        && (summaries.size() <= 26 || summaryAtLeastAsRecent(summaries[0], summaries[26]))
        && (summaries.size() <= 27 || summaryAtLeastAsRecent(summaries[0], summaries[27]))
        && (summaries.size() <= 28 || summaryAtLeastAsRecent(summaries[0], summaries[28]))
        && (summaries.size() <= 29 || summaryAtLeastAsRecent(summaries[0], summaries[29]))
        && (summaries.size() <= 30 || summaryAtLeastAsRecent(summaries[0], summaries[30]))
        && (summaries.size() <= 31 || summaryAtLeastAsRecent(summaries[0], summaries[31]))
        && (summaries.size() <= 32 || summaryAtLeastAsRecent(summaries[0], summaries[32]))
        && (summaries.size() <= 33 || summaryAtLeastAsRecent(summaries[0], summaries[33]))
        && (summaries.size() <= 34 || summaryAtLeastAsRecent(summaries[0], summaries[34]))
        && (summaries.size() <= 35 || summaryAtLeastAsRecent(summaries[0], summaries[35]))
        && (summaries.size() <= 36 || summaryAtLeastAsRecent(summaries[0], summaries[36]))
        && (summaries.size() <= 37 || summaryAtLeastAsRecent(summaries[0], summaries[37]))
        && (summaries.size() <= 38 || summaryAtLeastAsRecent(summaries[0], summaries[38]))
        && (summaries.size() <= 39 || summaryAtLeastAsRecent(summaries[0], summaries[39]))
        && (summaries.size() <= 40 || summaryAtLeastAsRecent(summaries[0], summaries[40]))
        && (summaries.size() <= 41 || summaryAtLeastAsRecent(summaries[0], summaries[41]))
        && (summaries.size() <= 42 || summaryAtLeastAsRecent(summaries[0], summaries[42]))
        && (summaries.size() <= 43 || summaryAtLeastAsRecent(summaries[0], summaries[43]))
        && (summaries.size() <= 44 || summaryAtLeastAsRecent(summaries[0], summaries[44]))
        && (summaries.size() <= 45 || summaryAtLeastAsRecent(summaries[0], summaries[45]))
        && (summaries.size() <= 46 || summaryAtLeastAsRecent(summaries[0], summaries[46]))
        && (summaries.size() <= 47 || summaryAtLeastAsRecent(summaries[0], summaries[47]))
        && (summaries.size() <= 48 || summaryAtLeastAsRecent(summaries[0], summaries[48]))
        && (summaries.size() <= 49 || summaryAtLeastAsRecent(summaries[0], summaries[49]))
        && (summaries.size() <= 50 || summaryAtLeastAsRecent(summaries[0], summaries[50]))
        && (summaries.size() <= 1 || summaryNoLater(summaries[summaries.size() - 1], summaries[1]))
        && (summaries.size() <= 2 || summaryNoLater(summaries[summaries.size() - 1], summaries[2]))
        && (summaries.size() <= 3 || summaryNoLater(summaries[summaries.size() - 1], summaries[3]))
        && (summaries.size() <= 4 || summaryNoLater(summaries[summaries.size() - 1], summaries[4]))
        && (summaries.size() <= 5 || summaryNoLater(summaries[summaries.size() - 1], summaries[5]))
        && (summaries.size() <= 6 || summaryNoLater(summaries[summaries.size() - 1], summaries[6]))
        && (summaries.size() <= 7 || summaryNoLater(summaries[summaries.size() - 1], summaries[7]))
        && (summaries.size() <= 8 || summaryNoLater(summaries[summaries.size() - 1], summaries[8]))
        && (summaries.size() <= 9 || summaryNoLater(summaries[summaries.size() - 1], summaries[9]))
        && (summaries.size() <= 10 || summaryNoLater(summaries[summaries.size() - 1], summaries[10]))
        && (summaries.size() <= 11 || summaryNoLater(summaries[summaries.size() - 1], summaries[11]))
        && (summaries.size() <= 12 || summaryNoLater(summaries[summaries.size() - 1], summaries[12]))
        && (summaries.size() <= 13 || summaryNoLater(summaries[summaries.size() - 1], summaries[13]))
        && (summaries.size() <= 14 || summaryNoLater(summaries[summaries.size() - 1], summaries[14]))
        && (summaries.size() <= 15 || summaryNoLater(summaries[summaries.size() - 1], summaries[15]))
        && (summaries.size() <= 16 || summaryNoLater(summaries[summaries.size() - 1], summaries[16]))
        && (summaries.size() <= 17 || summaryNoLater(summaries[summaries.size() - 1], summaries[17]))
        && (summaries.size() <= 18 || summaryNoLater(summaries[summaries.size() - 1], summaries[18]))
        && (summaries.size() <= 19 || summaryNoLater(summaries[summaries.size() - 1], summaries[19]))
        && (summaries.size() <= 20 || summaryNoLater(summaries[summaries.size() - 1], summaries[20]))
        && (summaries.size() <= 21 || summaryNoLater(summaries[summaries.size() - 1], summaries[21]))
        && (summaries.size() <= 22 || summaryNoLater(summaries[summaries.size() - 1], summaries[22]))
        && (summaries.size() <= 23 || summaryNoLater(summaries[summaries.size() - 1], summaries[23]))
        && (summaries.size() <= 24 || summaryNoLater(summaries[summaries.size() - 1], summaries[24]))
        && (summaries.size() <= 25 || summaryNoLater(summaries[summaries.size() - 1], summaries[25]))
        && (summaries.size() <= 26 || summaryNoLater(summaries[summaries.size() - 1], summaries[26]))
        && (summaries.size() <= 27 || summaryNoLater(summaries[summaries.size() - 1], summaries[27]))
        && (summaries.size() <= 28 || summaryNoLater(summaries[summaries.size() - 1], summaries[28]))
        && (summaries.size() <= 29 || summaryNoLater(summaries[summaries.size() - 1], summaries[29]))
        && (summaries.size() <= 30 || summaryNoLater(summaries[summaries.size() - 1], summaries[30]))
        && (summaries.size() <= 31 || summaryNoLater(summaries[summaries.size() - 1], summaries[31]))
        && (summaries.size() <= 32 || summaryNoLater(summaries[summaries.size() - 1], summaries[32]))
        && (summaries.size() <= 33 || summaryNoLater(summaries[summaries.size() - 1], summaries[33]))
        && (summaries.size() <= 34 || summaryNoLater(summaries[summaries.size() - 1], summaries[34]))
        && (summaries.size() <= 35 || summaryNoLater(summaries[summaries.size() - 1], summaries[35]))
        && (summaries.size() <= 36 || summaryNoLater(summaries[summaries.size() - 1], summaries[36]))
        && (summaries.size() <= 37 || summaryNoLater(summaries[summaries.size() - 1], summaries[37]))
        && (summaries.size() <= 38 || summaryNoLater(summaries[summaries.size() - 1], summaries[38]))
        && (summaries.size() <= 39 || summaryNoLater(summaries[summaries.size() - 1], summaries[39]))
        && (summaries.size() <= 40 || summaryNoLater(summaries[summaries.size() - 1], summaries[40]))
        && (summaries.size() <= 41 || summaryNoLater(summaries[summaries.size() - 1], summaries[41]))
        && (summaries.size() <= 42 || summaryNoLater(summaries[summaries.size() - 1], summaries[42]))
        && (summaries.size() <= 43 || summaryNoLater(summaries[summaries.size() - 1], summaries[43]))
        && (summaries.size() <= 44 || summaryNoLater(summaries[summaries.size() - 1], summaries[44]))
        && (summaries.size() <= 45 || summaryNoLater(summaries[summaries.size() - 1], summaries[45]))
        && (summaries.size() <= 46 || summaryNoLater(summaries[summaries.size() - 1], summaries[46]))
        && (summaries.size() <= 47 || summaryNoLater(summaries[summaries.size() - 1], summaries[47]))
        && (summaries.size() <= 48 || summaryNoLater(summaries[summaries.size() - 1], summaries[48]))
        && (summaries.size() <= 49 || summaryNoLater(summaries[summaries.size() - 1], summaries[49]))
        && (summaries.size() <= 50 || summaryNoLater(summaries[summaries.size() - 1], summaries[50]))
          )
        );
    }

    function isSafeOldestCompaction(oldSummaries, beforeExists) {
      return !beforeExists
        && oldSummaries is list
        && oldSummaries.size() == 51
        && validProjectionBounds(oldSummaries);
    }

    function oldSummaryMayBeRemoved(summary, newSummaries, orderId, canDropOldest, oldestSummary) {
      return summary is map
        && (
          summary.status == 'cancelled'
          || summary.id == orderId
          || summary in newSummaries
          || (canDropOldest && summary == oldestSummary)
        );
    }

    function validPreviousProjectionRetention(oldSummaries, newSummaries, orderId, canDropOldest, oldestSummary) {
      return oldSummaries is list
        && oldSummaries.size() <= 51
        && (oldSummaries.size() <= 0 || oldSummaryMayBeRemoved(oldSummaries[0], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 1 || oldSummaryMayBeRemoved(oldSummaries[1], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 2 || oldSummaryMayBeRemoved(oldSummaries[2], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 3 || oldSummaryMayBeRemoved(oldSummaries[3], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 4 || oldSummaryMayBeRemoved(oldSummaries[4], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 5 || oldSummaryMayBeRemoved(oldSummaries[5], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 6 || oldSummaryMayBeRemoved(oldSummaries[6], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 7 || oldSummaryMayBeRemoved(oldSummaries[7], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 8 || oldSummaryMayBeRemoved(oldSummaries[8], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 9 || oldSummaryMayBeRemoved(oldSummaries[9], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 10 || oldSummaryMayBeRemoved(oldSummaries[10], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 11 || oldSummaryMayBeRemoved(oldSummaries[11], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 12 || oldSummaryMayBeRemoved(oldSummaries[12], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 13 || oldSummaryMayBeRemoved(oldSummaries[13], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 14 || oldSummaryMayBeRemoved(oldSummaries[14], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 15 || oldSummaryMayBeRemoved(oldSummaries[15], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 16 || oldSummaryMayBeRemoved(oldSummaries[16], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 17 || oldSummaryMayBeRemoved(oldSummaries[17], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 18 || oldSummaryMayBeRemoved(oldSummaries[18], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 19 || oldSummaryMayBeRemoved(oldSummaries[19], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 20 || oldSummaryMayBeRemoved(oldSummaries[20], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 21 || oldSummaryMayBeRemoved(oldSummaries[21], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 22 || oldSummaryMayBeRemoved(oldSummaries[22], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 23 || oldSummaryMayBeRemoved(oldSummaries[23], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 24 || oldSummaryMayBeRemoved(oldSummaries[24], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 25 || oldSummaryMayBeRemoved(oldSummaries[25], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 26 || oldSummaryMayBeRemoved(oldSummaries[26], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 27 || oldSummaryMayBeRemoved(oldSummaries[27], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 28 || oldSummaryMayBeRemoved(oldSummaries[28], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 29 || oldSummaryMayBeRemoved(oldSummaries[29], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 30 || oldSummaryMayBeRemoved(oldSummaries[30], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 31 || oldSummaryMayBeRemoved(oldSummaries[31], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 32 || oldSummaryMayBeRemoved(oldSummaries[32], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 33 || oldSummaryMayBeRemoved(oldSummaries[33], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 34 || oldSummaryMayBeRemoved(oldSummaries[34], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 35 || oldSummaryMayBeRemoved(oldSummaries[35], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 36 || oldSummaryMayBeRemoved(oldSummaries[36], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 37 || oldSummaryMayBeRemoved(oldSummaries[37], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 38 || oldSummaryMayBeRemoved(oldSummaries[38], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 39 || oldSummaryMayBeRemoved(oldSummaries[39], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 40 || oldSummaryMayBeRemoved(oldSummaries[40], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 41 || oldSummaryMayBeRemoved(oldSummaries[41], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 42 || oldSummaryMayBeRemoved(oldSummaries[42], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 43 || oldSummaryMayBeRemoved(oldSummaries[43], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 44 || oldSummaryMayBeRemoved(oldSummaries[44], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 45 || oldSummaryMayBeRemoved(oldSummaries[45], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 46 || oldSummaryMayBeRemoved(oldSummaries[46], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 47 || oldSummaryMayBeRemoved(oldSummaries[47], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 48 || oldSummaryMayBeRemoved(oldSummaries[48], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 49 || oldSummaryMayBeRemoved(oldSummaries[49], newSummaries, orderId, canDropOldest, oldestSummary))
        && (oldSummaries.size() <= 50 || oldSummaryMayBeRemoved(oldSummaries[50], newSummaries, orderId, canDropOldest, oldestSummary));
    }

    function validCustomer(data) {
      return data.keys().hasOnly([
          'name', 'phone', 'phoneNormalized', 'address',
          'totalOrders', 'totalSpent', 'lastOrderDate', 'lastOrderDateOrderId',
          'lastOrderMutationOrderId', 'lastOrderMutationId', 'orderSummaries', 'note', 'createdAt'
        ])
        && data.keys().hasAll([
          'name', 'phone', 'phoneNormalized', 'address',
          'totalOrders', 'totalSpent', 'lastOrderDate', 'createdAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.phone is string
        && data.phoneNormalized is string
        && data.address is string
        && data.totalOrders is int
        && data.totalOrders >= 0
        && data.totalSpent is number
        && data.totalSpent >= 0
        && data.lastOrderDate is string
        && (!('lastOrderDateOrderId' in data.keys())
          || data.lastOrderDateOrderId == null
          || (data.lastOrderDateOrderId is string && data.lastOrderDateOrderId.size() > 0))
        && (!('lastOrderMutationOrderId' in data.keys())
          || (data.lastOrderMutationOrderId is string && data.lastOrderMutationOrderId.size() > 0))
        && (!('lastOrderMutationId' in data.keys())
          || (data.lastOrderMutationId is string && data.lastOrderMutationId.size() > 0))
        && data.createdAt is string
        && (!('orderSummaries' in data.keys()) || data.orderSummaries is list)
        && (!('note' in data.keys()) || data.note == null || data.note is string);
    }

    // Membership records remain admin-managed. Users can read their own membership.
    match /users/{userId} {
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.role in ['admin', 'staff']
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'role', 'status', 'createdAt', 'updatedAt']);
      allow delete: if false;
    }

    function validInitialOrder(data) {
      return validOrder(data)
        && data.status == 'new'
        && data.statusHistory.size() == 1
        && validStatusHistoryEntry(data.statusHistory[0])
        && data.statusHistory[0].status == 'new'
        && (!('createdByUid' in data.keys())
          || (data.createdByUid == request.auth.uid && data.statusHistory[0].actorUid == data.createdByUid));
    }

    function validStatusHistoryEntry(entry) {
      return entry is map
        && entry.keys().hasOnly(['id', 'status', 'timestamp', 'note', 'actorName', 'actorUid'])
        && entry.keys().hasAll(['id', 'status', 'timestamp', 'actorName'])
        && entry.id is string
        && entry.id.size() > 0
        && entry.status in ['new', 'confirmed', 'delivering', 'completed', 'cancelled']
        && entry.timestamp is string
        && entry.timestamp.size() > 0
        && entry.actorName is string
        && entry.actorName.size() > 0
        && (!('note' in entry.keys()) || entry.note == null || entry.note is string)
        && (!('actorUid' in entry.keys()) || (entry.actorUid is string && entry.actorUid.size() > 0 && entry.actorUid == request.auth.uid));
    }

    function validStatusTransition(from, to) {
      return (from == 'new' && to in ['confirmed', 'cancelled'])
        || (from == 'confirmed' && to in ['delivering', 'cancelled'])
        || (from == 'delivering' && to == 'completed');
    }

    // History must append exactly one valid entry while preserving the complete prior
    // list in its original order. Same-status edits are permitted only before delivery.
    // Lifecycle transitions may change only status + history, never order/financial data.
    function validStatusChange(oldData, newData) {
      let historySize = newData.statusHistory.size();
      let sameStatus = newData.status == oldData.status;
      let historyEntry = newData.statusHistory[historySize - 1];
      return historySize == oldData.statusHistory.size() + 1
        && newData.statusHistory == oldData.statusHistory.concat([historyEntry])
        && validStatusHistoryEntry(historyEntry)
        && (!('createdByUid' in oldData.keys())
          || ('actorUid' in historyEntry.keys() && historyEntry.actorUid == request.auth.uid))
        && historyEntry.status == newData.status
        && (
          (sameStatus && oldData.status in ['new', 'confirmed'])
          || (
            !sameStatus
            && validStatusTransition(oldData.status, newData.status)
            && newData.diff(oldData).affectedKeys().hasOnly(['status', 'statusHistory'])
          )
        );
    }

    // Order writes must keep the corresponding per-order customer projection coherent
    // in the same transaction/batch. This does not prove the customer's full aggregates.
    function hasMatchingCustomerOrderProjection(orderId, orderData) {
      let customerAfter = getAfter(
        /databases/$(database)/documents/customers/$(orderData.customerId)
      );
      let historySize = orderData.statusHistory.size();
      let expectedSummary = {
        'id': orderId,
        'status': orderData.status,
        'total': orderData.summary.total,
        'createdAt': orderData.createdAt
      };
      return customerAfter.data.orderSummaries is list
        && customerAfter.data.lastOrderMutationOrderId == orderId
        && customerAfter.data.lastOrderMutationId == orderData.statusHistory[historySize - 1].id
        && (
          (orderData.status == 'cancelled' && !(expectedSummary in customerAfter.data.orderSummaries))
          || (orderData.status != 'cancelled' && expectedSummary in customerAfter.data.orderSummaries)
        );
    }

    // Spark-compatible internal-team model. Rules enforce lifecycle and document invariants,
    // but cannot prove cross-document arithmetic or reconstruct customer aggregates.
    match /orders/{orderId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember()
        && validInitialOrder(request.resource.data)
        && hasMatchingCustomerOrderProjection(orderId, request.resource.data);
      allow update: if isActiveMember()
        && validOrder(request.resource.data)
        && validStatusChange(resource.data, request.resource.data)
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null)
        && hasMatchingCustomerOrderProjection(orderId, request.resource.data);
      allow delete: if false;
    }

    function hasMatchingFirstOrderProjection(customerId, customerData) {
      return customerData.orderSummaries is list
        && customerData.orderSummaries.size() == 1
        && customerData.orderSummaries[0] is map
        && customerData.orderSummaries[0].keys().hasOnly(['id', 'status', 'total', 'createdAt'])
        && customerData.orderSummaries[0].keys().hasAll(['id', 'status', 'total', 'createdAt'])
        && customerData.orderSummaries[0].status == 'new'
        && customerData.totalOrders == 1
        && customerData.totalSpent == 0
        && customerData.lastOrderDate == customerData.orderSummaries[0].createdAt
        && customerData.lastOrderMutationOrderId == customerData.orderSummaries[0].id
        && customerData.lastOrderMutationId == getAfter(/databases/$(database)/documents/orders/$(customerData.orderSummaries[0].id)).data.statusHistory[0].id
        && customerData.lastOrderDateOrderId == customerData.orderSummaries[0].id
        && getAfter(/databases/$(database)/documents/orders/$(customerData.orderSummaries[0].id)).data.customerId == customerId
        && getAfter(/databases/$(database)/documents/orders/$(customerData.orderSummaries[0].id)).data.status == 'new'
        && getAfter(/databases/$(database)/documents/orders/$(customerData.orderSummaries[0].id)).data.summary.total == customerData.orderSummaries[0].total
        && getAfter(/databases/$(database)/documents/orders/$(customerData.orderSummaries[0].id)).data.createdAt == customerData.orderSummaries[0].createdAt
        && getAfter(/databases/$(database)/documents/orders/$(customerData.orderSummaries[0].id)).data.customerSnapshot.name == customerData.name
        && getAfter(/databases/$(database)/documents/orders/$(customerData.orderSummaries[0].id)).data.customerSnapshot.phone == customerData.phone
        && getAfter(/databases/$(database)/documents/orders/$(customerData.orderSummaries[0].id)).data.customerSnapshot.address == customerData.address;
    }


    // Customer aggregate writes by staff must be tied to a real order write in the
    // same transaction. Keep this helper's document reads bounded: the order's before
    // and after snapshots are reused for history, projection and scalar-delta checks.
    function validLastOrderDateSource(customerId) {
      let summaries = request.resource.data.get('orderSummaries', []);
      let sourceId = request.resource.data.get('lastOrderDateOrderId', null);
      let source = sourceId is string && sourceId.size() > 0
        ? getAfter(/databases/$(database)/documents/orders/$(sourceId)).data
        : {};
      return (
        request.resource.data.totalOrders == 0
        && request.resource.data.lastOrderDate == ''
        && sourceId == null
        && summaries is list
        && summaries.size() == 0
      ) || (
        request.resource.data.totalOrders > 0
        && summaries is list
        && summaries.size() > 0
        && sourceId is string
        && sourceId == summaries[0].id
        && source.customerId == customerId
        && source.status in ['new', 'confirmed', 'delivering', 'completed']
        && source.createdAt == request.resource.data.lastOrderDate
        && {
          'id': sourceId,
          'status': source.status,
          'total': source.summary.total,
          'createdAt': source.createdAt
        } == summaries[0]
      );
    }

    // Staff may remove cancelled cache rows, replace the summary for the order being
    // mutated, and compact only the oldest row when a full, valid projection receives
    // a new order. No active row can be silently dropped to roll the date source back.
    function validCustomerOrderProjection(expectedSummary, orderId, beforeExists, afterStatus) {
      let oldSummaries = resource.data.get('orderSummaries', []);
      let newSummaries = request.resource.data.get('orderSummaries', []);
      let canDropOldest = isSafeOldestCompaction(oldSummaries, beforeExists);
      let oldestSummary = canDropOldest ? oldSummaries[50] : {};
      let allowedNewSummaries = afterStatus == 'cancelled'
        ? oldSummaries.toSet()
        : oldSummaries.toSet().union([expectedSummary].toSet());
      return oldSummaries is list
        && oldSummaries.size() <= 51
        && validProjectionBounds(newSummaries)
        && newSummaries.toSet().hasOnly(allowedNewSummaries)
        && (
          (afterStatus == 'cancelled' && !(expectedSummary in newSummaries))
          || (afterStatus != 'cancelled' && expectedSummary in newSummaries)
        )
        && validPreviousProjectionRetention(
          oldSummaries, newSummaries, orderId, canDropOldest, oldestSummary
        );
    }

    function validCustomerOrderMutation(customerId, orderId) {
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      let beforeExists = exists(orderPath);
      let before = beforeExists ? get(orderPath).data : {};
      let after = getAfter(orderPath).data;
      let oldActive = beforeExists && before.status != 'cancelled' ? 1 : 0;
      let newActive = after.status != 'cancelled' ? 1 : 0;
      let oldCompletedTotal = beforeExists && before.status == 'completed' ? before.summary.total : 0;
      let newCompletedTotal = after.status == 'completed' ? after.summary.total : 0;
      let expectedSummary = {
        'id': orderId,
        'status': after.status,
        'total': after.summary.total,
        'createdAt': after.createdAt
      };
      return after.customerId == customerId
        && (!beforeExists || before.customerId == customerId)
        && after.statusHistory is list
        && after.statusHistory.size() == (beforeExists ? before.statusHistory.size() + 1 : 1)
        && after.statusHistory[after.statusHistory.size() - 1].id == request.resource.data.lastOrderMutationId
        && request.resource.data.lastOrderMutationId != resource.data.get('lastOrderMutationId', null)
        && validCustomerOrderProjection(expectedSummary, orderId, beforeExists, after.status)
        && request.resource.data.totalOrders == resource.data.totalOrders + newActive - oldActive
        && request.resource.data.totalSpent == resource.data.totalSpent + newCompletedTotal - oldCompletedTotal
        && validLastOrderDateSource(customerId)
        && boundedCustomerProjection(request.resource.data);
    }

    function hasMatchingCustomerOrderMutation(customerId) {
      let orderId = request.resource.data.get('lastOrderMutationOrderId', '');
      return orderId is string
        && orderId.size() > 0
        && validCustomerOrderMutation(customerId, orderId);
    }

    function isCustomerProfileOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'address', 'note']);
    }

    // Full aggregate rebuild is a privileged admin maintenance path. Staff cannot
    // invoke it; normal staff writes must use the order-linked transaction above.
    function isAdminAggregateRepair() {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'totalOrders', 'totalSpent', 'lastOrderDate', 'lastOrderDateOrderId', 'orderSummaries'
        ]);
    }

    match /customers/{customerId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember()
        && validCustomer(request.resource.data)
        && boundedCustomerProjection(request.resource.data)
        && (
          (request.resource.data.totalOrders == 0
            && request.resource.data.totalSpent == 0
            && request.resource.data.lastOrderDate == ''
            && (!('orderSummaries' in request.resource.data.keys())
              || request.resource.data.orderSummaries.size() == 0))
          || hasMatchingFirstOrderProjection(customerId, request.resource.data)
        );
      allow update: if isActiveMember() && validCustomer(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['orderSummaries']) || boundedCustomerProjection(request.resource.data))
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.phoneNormalized == resource.data.phoneNormalized
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          isCustomerProfileOnlyUpdate()
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'totalOrders', 'totalSpent', 'lastOrderDate', 'lastOrderDateOrderId',
              'orderSummaries', 'lastOrderMutationOrderId', 'lastOrderMutationId'
            ])
            && hasMatchingCustomerOrderMutation(customerId)
          )
          || isAdminAggregateRepair()
        );
      allow delete: if false;
    }

    function validProduct(data) {
      return data.keys().hasOnly([
          'name', 'price', 'unit', 'isActive', 'category',
          'imageUrl', 'imageUrls', 'note', 'createdAt'
        ])
        && data.keys().hasAll(['name', 'price', 'unit', 'isActive', 'createdAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && data.price is number
        && data.price >= 0
        && data.unit is string
        && data.unit.size() > 0
        && data.unit.size() <= 40
        && data.isActive is bool
        && data.createdAt is string
        && (data.get('category', null) == null || data.category is string)
        && (data.get('imageUrl', null) == null || data.imageUrl is string)
        && data.get('imageUrls', []) is list
        && data.get('imageUrls', []).size() <= 5
        && (data.get('note', null) == null || data.note is string);
    }

    // Product catalog policy: all active members can read; only admins can create
    // or edit. createdAt is immutable and delete is disabled to preserve order history.
    match /products/{productId} {
      allow read: if isActiveMember();
      allow create: if isAdmin() && validProduct(request.resource.data);
      allow update: if isAdmin()
        && validProduct(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'price', 'unit', 'isActive', 'category',
          'imageUrl', 'imageUrls', 'note'
        ]);
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow read: if isActiveMember();
      allow create, update, delete: if isAdmin();
    }
  }
}
