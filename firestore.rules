rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function membershipPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isActiveMember() {
      return isAuthenticated()
        && exists(membershipPath())
        && get(membershipPath()).data.status == 'active'
        && get(membershipPath()).data.role in ['admin', 'staff'];
    }

    function isAdmin() {
      return isActiveMember() && get(membershipPath()).data.role == 'admin';
    }

    function validOrder(data) {
      return data.keys().hasOnly([
          'customerId', 'customerSnapshot', 'items', 'summary', 'status',
          'statusHistory', 'note', 'createdAt', 'createdBy', 'createdByUid', 'deliveryDate'
        ])
        && data.keys().hasAll([
          'customerId', 'customerSnapshot', 'items', 'summary', 'status',
          'statusHistory', 'createdAt', 'createdBy'
        ])
        && data.customerId is string
        && data.customerId.size() > 0
        && data.customerSnapshot is map
        && data.customerSnapshot.keys().hasOnly(['name', 'phone', 'address'])
        && data.customerSnapshot.name is string
        && data.customerSnapshot.phone is string
        && data.customerSnapshot.address is string
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 100
        && data.summary is map
        && data.summary.keys().hasOnly(['subtotal', 'deliveryFee', 'discount', 'total'])
        && data.summary.subtotal is number
        && data.summary.subtotal >= 0
        && data.summary.deliveryFee is number
        && data.summary.deliveryFee >= 0
        && data.summary.discount is number
        && data.summary.discount >= 0
        && data.summary.total is number
        && data.summary.total >= 0
        && data.status in ['new', 'confirmed', 'delivering', 'completed', 'cancelled']
        && data.statusHistory is list
        && data.statusHistory.size() > 0
        && data.createdAt is string
        && data.createdBy is string
        && (!('createdByUid' in data.keys()) || (data.createdByUid is string && data.createdByUid.size() > 0))
        && (!('note' in data.keys()) || data.note == null || data.note is string)
        && (!('deliveryDate' in data.keys()) || data.deliveryDate == null || data.deliveryDate is string);
    }

    function boundedCustomerProjection(data) {
      return !('orderSummaries' in data.keys()) || data.orderSummaries.size() <= 10;
    }

    function validCustomerOrderSummary(summary) {
      return summary is map
        && summary.keys().hasOnly(['id', 'status', 'total', 'createdAt'])
        && summary.keys().hasAll(['id', 'status', 'total', 'createdAt'])
        && summary.id is string
        && summary.id.size() > 0
        && summary.status in ['new', 'confirmed', 'delivering', 'completed']
        && summary.total is number
        && summary.total >= 0
        && summary.createdAt is string
        && summary.createdAt.size() > 0;
    }

    function summaryAtLeastAsRecent(left, right) {
      return left.createdAt > right.createdAt
        || (left.createdAt == right.createdAt && left.id >= right.id);
    }

    function summaryNoLater(left, right) {
      return left.createdAt < right.createdAt
        || (left.createdAt == right.createdAt && left.id <= right.id);
    }

    // Keep each Rules expression small enough for the Firestore Rules evaluator.
    // The projection is active-only; its first row is latest and its last row is oldest.
    // Keep the active-only projection small enough for Firestore Rules' expression budget.
    // Its first row is latest and its last row is oldest.
    function validLatestChunk0(summaries) {
      return (summaries.size() <= 1 || summaryAtLeastAsRecent(summaries[0], summaries[1]))
        && (summaries.size() <= 2 || summaryAtLeastAsRecent(summaries[0], summaries[2]))
        && (summaries.size() <= 3 || summaryAtLeastAsRecent(summaries[0], summaries[3]))
        && (summaries.size() <= 4 || summaryAtLeastAsRecent(summaries[0], summaries[4]))
        && (summaries.size() <= 5 || summaryAtLeastAsRecent(summaries[0], summaries[5]))
        && (summaries.size() <= 6 || summaryAtLeastAsRecent(summaries[0], summaries[6]))
        && (summaries.size() <= 7 || summaryAtLeastAsRecent(summaries[0], summaries[7]))
        && (summaries.size() <= 8 || summaryAtLeastAsRecent(summaries[0], summaries[8]))
        && (summaries.size() <= 9 || summaryAtLeastAsRecent(summaries[0], summaries[9]))
        ;
    }

    function validOldestChunk0(summaries) {
      return (summaries.size() <= 1 || summaryNoLater(summaries[summaries.size() - 1], summaries[1]))
        && (summaries.size() <= 2 || summaryNoLater(summaries[summaries.size() - 1], summaries[2]))
        && (summaries.size() <= 3 || summaryNoLater(summaries[summaries.size() - 1], summaries[3]))
        && (summaries.size() <= 4 || summaryNoLater(summaries[summaries.size() - 1], summaries[4]))
        && (summaries.size() <= 5 || summaryNoLater(summaries[summaries.size() - 1], summaries[5]))
        && (summaries.size() <= 6 || summaryNoLater(summaries[summaries.size() - 1], summaries[6]))
        && (summaries.size() <= 7 || summaryNoLater(summaries[summaries.size() - 1], summaries[7]))
        && (summaries.size() <= 8 || summaryNoLater(summaries[summaries.size() - 1], summaries[8]))
        && (summaries.size() <= 9 || summaryNoLater(summaries[summaries.size() - 1], summaries[9]))
;
    }

    function validProjectionBounds(summaries) {
      return summaries is list
        && summaries.size() <= 10
        && (summaries.size() == 0 || validCustomerOrderSummary(summaries[0]))
        && validLatestChunk0(summaries)
        && (summaries.size() < 10 || validOldestChunk0(summaries));
    }

    function isSafeOldestCompaction(oldSummaries, beforeExists, oldOrderSummary, expectedSummary, afterStatus) {
      return oldSummaries is list
        && oldSummaries.size() == 10
        && validProjectionBounds(oldSummaries)
        && afterStatus != 'cancelled'
        && summaryAtLeastAsRecent(expectedSummary, oldSummaries[9])
        && (!beforeExists || !(oldOrderSummary in oldSummaries));
    }

    // Existing summaries may only disappear when they belong to the order being
    // mutated or are the verified oldest row during a full-cache compaction. Legacy
    // cancelled/malformed rows require the admin repair path before staff order writes.
    function validPreviousProjectionRetention(oldSummaries, newSummaries, oldOrderSummary, canDropOldest, oldestSummary) {
      let allowedRemoved = [oldOrderSummary].toSet().union(
        canDropOldest ? [oldestSummary].toSet() : [].toSet()
      );
      return oldSummaries is list
        && oldSummaries.size() <= 10
        && oldSummaries.toSet().difference(newSummaries.toSet()).hasOnly(allowedRemoved);
    }

    function validCustomer(data) {
      return data.keys().hasOnly([
          'name', 'phone', 'phoneNormalized', 'address',
          'totalOrders', 'totalSpent', 'lastOrderDate', 'lastOrderDateOrderId',
          'lastOrderMutationOrderId', 'lastOrderMutationId', 'lastOrderRefillOrderId', 'orderSummaries', 'note', 'createdAt'
        ])
        && data.keys().hasAll([
          'name', 'phone', 'phoneNormalized', 'address',
          'totalOrders', 'totalSpent', 'lastOrderDate', 'createdAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.phone is string
        && data.phoneNormalized is string
        && data.address is string
        && data.totalOrders is int
        && data.totalOrders >= 0
        && data.totalSpent is number
        && data.totalSpent >= 0
        && data.lastOrderDate is string
        && (!('lastOrderDateOrderId' in data.keys())
          || data.lastOrderDateOrderId == null
          || (data.lastOrderDateOrderId is string && data.lastOrderDateOrderId.size() > 0))
        && (!('lastOrderMutationOrderId' in data.keys())
          || (data.lastOrderMutationOrderId is string && data.lastOrderMutationOrderId.size() > 0))
        && (!('lastOrderMutationId' in data.keys())
          || (data.lastOrderMutationId is string && data.lastOrderMutationId.size() > 0))
        && (!('lastOrderRefillOrderId' in data.keys())
          || data.lastOrderRefillOrderId == null
          || (data.lastOrderRefillOrderId is string && data.lastOrderRefillOrderId.size() > 0))
        && data.createdAt is string
        && (!('orderSummaries' in data.keys()) || data.orderSummaries is list)
        && (!('note' in data.keys()) || data.note == null || data.note is string);
    }

    // Membership records remain admin-managed. Users can read their own membership.
    match /users/{userId} {
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.role in ['admin', 'staff']
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'role', 'status', 'createdAt', 'updatedAt']);
      allow delete: if false;
    }

    function validInitialOrder(data) {
      return validOrder(data)
        && data.status == 'new'
        && data.statusHistory.size() == 1
        && validStatusHistoryEntry(data.statusHistory[0])
        && data.statusHistory[0].status == 'new'
        && (!('createdByUid' in data.keys())
          || (data.createdByUid == request.auth.uid && data.statusHistory[0].actorUid == data.createdByUid));
    }

    function validStatusHistoryEntry(entry) {
      return entry is map
        && entry.keys().hasOnly(['id', 'status', 'timestamp', 'note', 'actorName', 'actorUid'])
        && entry.keys().hasAll(['id', 'status', 'timestamp', 'actorName'])
        && entry.id is string
        && entry.id.size() > 0
        && entry.status in ['new', 'confirmed', 'delivering', 'completed', 'cancelled']
        && entry.timestamp is string
        && entry.timestamp.size() > 0
        && entry.actorName is string
        && entry.actorName.size() > 0
        && (!('note' in entry.keys()) || entry.note == null || entry.note is string)
        && (!('actorUid' in entry.keys()) || (entry.actorUid is string && entry.actorUid.size() > 0 && entry.actorUid == request.auth.uid));
    }

    function validStatusTransition(from, to) {
      return (from == 'new' && to in ['confirmed', 'cancelled'])
        || (from == 'confirmed' && to in ['delivering', 'cancelled'])
        || (from == 'delivering' && to == 'completed');
    }

    // History must append exactly one valid entry while preserving the complete prior
    // list in its original order. Same-status edits are permitted only before delivery.
    // Lifecycle transitions may change only status + history, never order/financial data.
    function validStatusChange(oldData, newData) {
      let historySize = newData.statusHistory.size();
      let sameStatus = newData.status == oldData.status;
      let historyEntry = newData.statusHistory[historySize - 1];
      return historySize == oldData.statusHistory.size() + 1
        && newData.statusHistory == oldData.statusHistory.concat([historyEntry])
        && validStatusHistoryEntry(historyEntry)
        && (!('createdByUid' in oldData.keys())
          || ('actorUid' in historyEntry.keys() && historyEntry.actorUid == request.auth.uid))
        && historyEntry.status == newData.status
        && (
          (sameStatus && oldData.status in ['new', 'confirmed'])
          || (
            !sameStatus
            && validStatusTransition(oldData.status, newData.status)
            && newData.diff(oldData).affectedKeys().hasOnly(['status', 'statusHistory'])
          )
        );
    }

    // Order writes must keep the corresponding per-order customer projection coherent
    // in the same transaction/batch. This does not prove the customer's full aggregates.
    function hasMatchingCustomerOrderMutationMarker(orderId, orderData) {
      let customerPath = /databases/$(database)/documents/customers/$(orderData.customerId);
      let customerBeforeExists = exists(customerPath);
      let customerBefore = customerBeforeExists ? get(customerPath).data : {};
      let customerAfter = getAfter(customerPath).data;
      let historySize = orderData.statusHistory.size();
      let mutationId = orderData.statusHistory[historySize - 1].id;
      return customerAfter.lastOrderMutationOrderId == orderId
        && customerAfter.lastOrderMutationId == mutationId
        && customerAfter.lastOrderMutationId != customerBefore.get('lastOrderMutationId', null);
    }

    // Spark-compatible internal-team model. Rules enforce lifecycle and document invariants,
    // but cannot prove cross-document arithmetic or reconstruct customer aggregates.
    match /orders/{orderId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember()
        && validInitialOrder(request.resource.data)
        && hasMatchingCustomerOrderMutationMarker(orderId, request.resource.data);
      allow update: if isActiveMember()
        && validOrder(request.resource.data)
        && validStatusChange(resource.data, request.resource.data)
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null)
        && hasMatchingCustomerOrderMutationMarker(orderId, request.resource.data);
      allow delete: if false;
    }

    function hasMatchingFirstOrderProjection(customerId, customerData) {
      return customerData.orderSummaries is list
        && customerData.orderSummaries.size() == 1
        && customerData.orderSummaries[0] is map
        && customerData.orderSummaries[0].keys().hasOnly(['id', 'status', 'total', 'createdAt'])
        && customerData.orderSummaries[0].keys().hasAll(['id', 'status', 'total', 'createdAt'])
        && customerData.orderSummaries[0].status == 'new'
        && customerData.totalOrders == 1
        && customerData.totalSpent == 0
        && customerData.lastOrderDate == customerData.orderSummaries[0].createdAt
        && customerData.lastOrderMutationOrderId == customerData.orderSummaries[0].id
        && customerData.lastOrderMutationId == getAfter(/databases/$(database)/documents/orders/$(customerData.orderSummaries[0].id)).data.statusHistory[0].id
        && customerData.lastOrderDateOrderId == customerData.orderSummaries[0].id
        && getAfter(/databases/$(database)/documents/orders/$(customerData.orderSummaries[0].id)).data.customerId == customerId
        && getAfter(/databases/$(database)/documents/orders/$(customerData.orderSummaries[0].id)).data.status == 'new'
        && getAfter(/databases/$(database)/documents/orders/$(customerData.orderSummaries[0].id)).data.summary.total == customerData.orderSummaries[0].total
        && getAfter(/databases/$(database)/documents/orders/$(customerData.orderSummaries[0].id)).data.createdAt == customerData.orderSummaries[0].createdAt
        && getAfter(/databases/$(database)/documents/orders/$(customerData.orderSummaries[0].id)).data.customerSnapshot.name == customerData.name
        && getAfter(/databases/$(database)/documents/orders/$(customerData.orderSummaries[0].id)).data.customerSnapshot.phone == customerData.phone
        && getAfter(/databases/$(database)/documents/orders/$(customerData.orderSummaries[0].id)).data.customerSnapshot.address == customerData.address;
    }


    // Customer aggregate writes by staff must be tied to a real order write in the
    // same transaction. Keep this helper's document reads bounded: the order's before
    // and after snapshots are reused for history, projection and scalar-delta checks.
    function validLastOrderDateSource(customerId, orderId, after) {
      let summaries = request.resource.data.get('orderSummaries', []);
      let sourceId = request.resource.data.get('lastOrderDateOrderId', null);
      let source = sourceId == orderId
        ? after
        : (sourceId is string && sourceId.size() > 0
          ? getAfter(/databases/$(database)/documents/orders/$(sourceId)).data
          : {});
      return (
        request.resource.data.totalOrders == 0
        && request.resource.data.lastOrderDate == ''
        && sourceId == null
        && summaries is list
        && summaries.size() == 0
      ) || (
        request.resource.data.totalOrders > 0
        && summaries is list
        && summaries.size() > 0
        && sourceId is string
        && sourceId == summaries[0].id
        && source.customerId == customerId
        && source.status in ['new', 'confirmed', 'delivering', 'completed']
        && source.createdAt == request.resource.data.lastOrderDate
        && {
          'id': sourceId,
          'status': source.status,
          'total': source.summary.total,
          'createdAt': source.createdAt
        } == summaries[0]
      );
    }

    // Staff may remove cancelled cache rows, replace the summary for the order being
    // mutated, and compact only the oldest row when a full, valid projection receives
    // a new order. No active row can be silently dropped to roll the date source back.
    function customerRefillSummary() {
      let refillId = request.resource.data.get('lastOrderRefillOrderId', null);
      let refillOrder = refillId is string
        ? getAfter(/databases/$(database)/documents/orders/$(refillId)).data
        : {};
      return refillId is string ? {
        'id': refillId,
        'status': refillOrder.status,
        'total': refillOrder.summary.total,
        'createdAt': refillOrder.createdAt
      } : {};
    }

    function validCustomerRefill(customerId, orderId, newSummaries, afterStatus, refillSummary) {
      let refillId = request.resource.data.get('lastOrderRefillOrderId', null);
      let refillOrder = refillId is string
        ? getAfter(/databases/$(database)/documents/orders/$(refillId)).data
        : {};
      return refillId == null
        || (
          afterStatus == 'cancelled'
          && refillId is string
          && refillId.size() > 0
          && refillId != orderId
          && refillOrder.customerId == customerId
          && refillOrder.status in ['new', 'confirmed', 'delivering', 'completed']
          && validCustomerOrderSummary(refillSummary)
          && refillSummary in newSummaries
          && !(refillSummary in resource.data.get('orderSummaries', []))
        );
    }

    function validCustomerOrderProjection(customerId, expectedSummary, orderId, beforeExists, before, afterStatus) {
      let oldSummaries = resource.data.get('orderSummaries', []);
      let newSummaries = request.resource.data.get('orderSummaries', []);
      let oldOrderSummary = beforeExists ? {
        'id': orderId,
        'status': before.status,
        'total': before.summary.total,
        'createdAt': before.createdAt
      } : {};
      let wasProjected = oldOrderSummary in oldSummaries;
      let canDropOldest = isSafeOldestCompaction(
        oldSummaries, beforeExists, oldOrderSummary, expectedSummary, afterStatus
      );
      let oldestSummary = canDropOldest ? oldSummaries[9] : {};
      let refillId = request.resource.data.get('lastOrderRefillOrderId', null);
      let refillSummary = customerRefillSummary();
      let allowedNewSummaries = afterStatus == 'cancelled'
        ? oldSummaries.toSet().union(refillId is string ? [refillSummary].toSet() : [].toSet())
        : oldSummaries.toSet().union([expectedSummary].toSet());
      let mayOmitChangedSummary = afterStatus != 'cancelled'
        && !wasProjected
        && newSummaries.size() == 10
        && summaryNoLater(expectedSummary, newSummaries[9]);
      return oldSummaries is list
        && oldSummaries.size() <= 10
        && validProjectionBounds(newSummaries)
        && validCustomerRefill(customerId, orderId, newSummaries, afterStatus, refillSummary)
        && newSummaries.toSet().size() == newSummaries.size()
        && newSummaries.toSet().hasOnly(allowedNewSummaries)
        && (
          (afterStatus == 'cancelled' && !(expectedSummary in newSummaries))
          || (afterStatus != 'cancelled' && (expectedSummary in newSummaries || mayOmitChangedSummary))
        )
        && validPreviousProjectionRetention(
          oldSummaries, newSummaries, oldOrderSummary, canDropOldest, oldestSummary
        );
    }

    function validCustomerOrderMutation(customerId, orderId) {
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      let beforeExists = exists(orderPath);
      let before = beforeExists ? get(orderPath).data : {};
      let after = getAfter(orderPath).data;
      let oldActive = beforeExists && before.status != 'cancelled' ? 1 : 0;
      let newActive = after.status != 'cancelled' ? 1 : 0;
      let oldCompletedTotal = beforeExists && before.status == 'completed' ? before.summary.total : 0;
      let newCompletedTotal = after.status == 'completed' ? after.summary.total : 0;
      let expectedSummary = {
        'id': orderId,
        'status': after.status,
        'total': after.summary.total,
        'createdAt': after.createdAt
      };
      return after.customerId == customerId
        && (!beforeExists || before.customerId == customerId)
        && after.statusHistory is list
        && after.statusHistory.size() == (beforeExists ? before.statusHistory.size() + 1 : 1)
        && after.statusHistory[after.statusHistory.size() - 1].id == request.resource.data.lastOrderMutationId
        && request.resource.data.lastOrderMutationId != resource.data.get('lastOrderMutationId', null)
        && validCustomerOrderProjection(customerId, expectedSummary, orderId, beforeExists, before, after.status)
        && request.resource.data.totalOrders == resource.data.totalOrders + newActive - oldActive
        && request.resource.data.totalSpent == resource.data.totalSpent + newCompletedTotal - oldCompletedTotal
        && validLastOrderDateSource(customerId, orderId, after)
        && boundedCustomerProjection(request.resource.data);
    }

    function hasMatchingCustomerOrderMutation(customerId) {
      let orderId = request.resource.data.get('lastOrderMutationOrderId', '');
      return orderId is string
        && orderId.size() > 0
        && validCustomerOrderMutation(customerId, orderId);
    }

    function isCustomerProfileOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'address', 'note']);
    }

    // Full aggregate rebuild is a privileged admin maintenance path. Staff cannot
    // invoke it; normal staff writes must use the order-linked transaction above.
    function isAdminAggregateRepair() {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'totalOrders', 'totalSpent', 'lastOrderDate', 'lastOrderDateOrderId', 'lastOrderRefillOrderId', 'orderSummaries'
        ]);
    }

    match /customers/{customerId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember()
        && validCustomer(request.resource.data)
        && boundedCustomerProjection(request.resource.data)
        && (
          (request.resource.data.totalOrders == 0
            && request.resource.data.totalSpent == 0
            && request.resource.data.lastOrderDate == ''
            && (!('orderSummaries' in request.resource.data.keys())
              || request.resource.data.orderSummaries.size() == 0))
          || hasMatchingFirstOrderProjection(customerId, request.resource.data)
        );
      allow update: if isActiveMember() && validCustomer(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['orderSummaries']) || boundedCustomerProjection(request.resource.data))
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.phoneNormalized == resource.data.phoneNormalized
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          isCustomerProfileOnlyUpdate()
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'totalOrders', 'totalSpent', 'lastOrderDate', 'lastOrderDateOrderId',
              'orderSummaries', 'lastOrderMutationOrderId', 'lastOrderMutationId', 'lastOrderRefillOrderId'
            ])
            && hasMatchingCustomerOrderMutation(customerId)
          )
          || isAdminAggregateRepair()
        );
      allow delete: if false;
    }

    function validProduct(data) {
      return data.keys().hasOnly([
          'name', 'price', 'unit', 'isActive', 'category',
          'imageUrl', 'imageUrls', 'note', 'createdAt'
        ])
        && data.keys().hasAll(['name', 'price', 'unit', 'isActive', 'createdAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && data.price is number
        && data.price >= 0
        && data.unit is string
        && data.unit.size() > 0
        && data.unit.size() <= 40
        && data.isActive is bool
        && data.createdAt is string
        && (data.get('category', null) == null || data.category is string)
        && (data.get('imageUrl', null) == null || data.imageUrl is string)
        && data.get('imageUrls', []) is list
        && data.get('imageUrls', []).size() <= 5
        && (data.get('note', null) == null || data.note is string);
    }

    // Product catalog policy: all active members can read; only admins can create
    // or edit. createdAt is immutable and delete is disabled to preserve order history.
    match /products/{productId} {
      allow read: if isActiveMember();
      allow create: if isAdmin() && validProduct(request.resource.data);
      allow update: if isAdmin()
        && validProduct(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'price', 'unit', 'isActive', 'category',
          'imageUrl', 'imageUrls', 'note'
        ]);
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow read: if isActiveMember();
      allow create, update, delete: if isAdmin();
    }
  }
}
