rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: kiểm tra user đã xác thực qua Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: lấy document profile membership của user hiện tại
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper function: kiểm tra user có bản ghi thành viên trong hệ thống
    function isMember() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Helper function: kiểm tra user là thành viên đang kích hoạt (active)
    function isActiveMember() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // Helper function: kiểm tra thành viên có vai trò quản trị viên (admin)
    function isAdmin() {
      return isActiveMember() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Membership documents: Lưu trữ vai trò và trạng thái nhân sự do Server/Admin quản lý
    match /users/{userId} {
      // Thành viên chỉ được đọc hồ sơ của chính mình; cấm list danh sách và cấm ghi từ phía client
      allow get: if isAuthenticated() && request.auth.uid == userId;
      allow list: if false;
      allow write: if false;
    }

    // Orders: Quản lý đơn hàng tiệm hoa cho active members (admin & staff)
    match /orders/{orderId} {
      allow read, write: if isActiveMember();
    }

    // Customers: Quản lý khách hàng tiệm hoa cho active members (admin & staff)
    match /customers/{customerId} {
      allow read, write: if isActiveMember();
    }

    // Products: Bảng giá & sản phẩm tiệm hoa cho active members
    match /products/{productId} {
      allow read, write: if isActiveMember();
    }

    // Settings: Cấu hình thông tin tiệm hoa (settings/store) cho active members
    match /settings/{settingId} {
      allow read, write: if isActiveMember();
    }
  }
}
