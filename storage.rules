rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isActiveAdmin() {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
        && request.resource.name.matches('.*\\.(jpg|jpeg|png|webp|gif)$')
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Product images remain publicly readable for storefront and CRM views.
    // Product catalog writes are admin-only in Firestore, so image writes/deletes
    // must use the same active-admin boundary.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isActiveAdmin() && isImageFile();
      allow delete: if isActiveAdmin();
    }
  }
}
